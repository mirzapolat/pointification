# Optional: link shown on the "support / donate" button. Leave blank to hide it.
# VITE_* vars are inlined into the SPA bundle at build time.
VITE_DONATE_URL=

# Optional SMTP. When SMTP_HOST is empty, signup skips the emailed code and
# new accounts are verified immediately — handy for a private instance.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Where the SQLite database and uploaded logos live inside the container.
# Compose bind-mounts ./data onto /data, so these rarely need changing.
DATABASE_PATH=/data/pointification.db
LOGO_DIR=/data/logos

# Optional: host port the container is published on (defaults to 3000).
PORT=3000
